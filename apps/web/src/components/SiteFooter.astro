---
import LanguageSelect from '@/components/LanguageSelect.astro';
import { pagePath } from '@/lib/i18n';
import { footerNavItems, type Locale, navLabels } from '@/lib/site';

interface Props {
  locale: Locale;
  slug: string;
  hasAlternate: boolean;
}

const { locale, slug, hasAlternate } = Astro.props;
const labels = navLabels[locale];
---

<footer class="mt-auto">
  <div class="mx-auto w-full max-w-5xl px-4 sm:px-6">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-border py-8">
      <nav aria-label={locale === 'ja' ? 'フッターナビ' : 'Footer'} class="min-w-0 flex-1">
        <ul class="flex flex-wrap gap-x-4 gap-y-2">
          {
            footerNavItems.map((item) => (
              <li>
                <a
                  href={pagePath(locale, item.slug)}
                  data-nav-slug={item.slug}
                  class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                >
                  {labels[item.labelKey]}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="ml-auto shrink-0">
        <LanguageSelect locale={locale} slug={slug} hasAlternate={hasAlternate} />
      </div>
    </div>
  </div>
</footer>
