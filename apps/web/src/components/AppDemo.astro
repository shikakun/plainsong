---
import { countCharacters, pluralize } from '@/lib/character-count';
import { landingContent } from '@/lib/landing';
import type { Locale } from '@/lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { demo } = landingContent[locale];

const readableEm = locale === 'ja' ? 40 : 29;

const paragraphs = demo.text.map((paragraph) =>
  typeof paragraph === 'string' ? { text: paragraph, lang: undefined } : paragraph,
);
const total = countCharacters(paragraphs.map((paragraph) => paragraph.text).join('\n'));
---

<div
  class="demo"
  data-app-demo
  data-locale={locale}
  data-status-bar={JSON.stringify(demo.statusBar)}
  style={`--readable-em: ${readableEm}`}
>
  <div class="window" role="region" aria-label={demo.label} data-window>
    <div class="doc" data-doc>
      {
        paragraphs.map((paragraph, index) => {
          const Tag = index === 0 ? 'h1' : 'div';
          return <Tag lang={paragraph.lang}>{paragraph.text || <br />}</Tag>;
        })
      }
    </div>
    <div class="caret" hidden data-caret></div>
    <div class="titlebar" aria-hidden="true">
      <span class="lights"><i></i><i></i><i></i></span>
    </div>
    <div class="statusbar">
      <span class="count" data-count>{pluralize(demo.statusBar.characters, total, locale)}</span>
    </div>
  </div>
</div>

<script>
  import { countCharacters, pluralize } from '@/lib/character-count';
  import type { LandingDemo } from '@/lib/landing';

  const LINE_RATIO = 1.125;

  function setUp(root: HTMLElement) {
    const query = <T extends Element>(name: string) => {
      const el = root.querySelector<T>(`[data-${name}]`);
      if (!el) {
        throw new Error(`[data-${name}] is missing`);
      }
      return el;
    };
    const win = query<HTMLElement>('window');
    const doc = query<HTMLElement>('doc');
    const caret = query<HTMLElement>('caret');
    const count = query<HTMLElement>('count');
    const locale = root.dataset.locale ?? 'ja';
    const labels: LandingDemo['statusBar'] = JSON.parse(root.dataset.statusBar ?? '');
    const total = pluralize(
      labels.characters,
      countCharacters([...doc.children].map((line) => line.textContent ?? '').join('\n')),
      locale,
    );

    function selectedText() {
      const selection = getSelection();
      let text = '';
      if (!selection) {
        return text;
      }
      for (let i = 0; i < selection.rangeCount; i++) {
        const range = selection.getRangeAt(i).cloneRange();
        if (range.collapsed || !range.intersectsNode(doc)) {
          continue;
        }
        if (!doc.contains(range.startContainer)) {
          range.setStart(doc, 0);
        }
        if (!doc.contains(range.endContainer)) {
          range.setEnd(doc, doc.childNodes.length);
        }
        text += range.toString();
      }
      return text;
    }

    function placeCaret() {
      const last = doc.lastElementChild?.lastChild;
      if (!(last instanceof Text)) {
        return;
      }
      const range = document.createRange();
      range.setStart(last, last.data.length);
      range.collapse(true);
      const rect = [...range.getClientRects()].find((r) => r.height > 0);
      if (!rect) {
        return;
      }
      const origin = win.getBoundingClientRect();
      const height = LINE_RATIO * Number.parseFloat(getComputedStyle(doc).fontSize);
      caret.style.left = `${rect.right - origin.left - 1}px`;
      caret.style.top = `${rect.top - origin.top + rect.height / 2 - height / 2}px`;
      caret.style.height = `${height}px`;
    }

    function update() {
      const selected = countCharacters(selectedText());
      caret.hidden = selected > 0;
      count.textContent =
        selected > 0
          ? labels.withSelection
              .replace('{total}', total)
              .replace('{selected}', pluralize(labels.selected, selected, locale))
          : total;
    }

    document.addEventListener('selectionchange', update);
    new ResizeObserver(placeCaret).observe(doc);
    document.fonts.ready.then(placeCaret);
    placeCaret();
    update();
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-app-demo]')) {
    setUp(root);
  }
</script>

<style>
  @font-face {
    font-family: "Plainsong Japanese";
    src: local("HiraginoSans-W4"), local("Hiragino Sans W4");
    unicode-range: U+3000-30FF, U+31F0-31FF, U+3400-4DBF, U+4E00-9FFF, U+F900-FAFF, U+FF00-FFEF;
  }

  .demo {
    --label: rgb(0 0 0 / 0.85);
    /* アプリのsecondaryLabelColorより少し濃くして、コントラスト比4.5:1を満たす */
    --label-secondary: rgb(0 0 0 / 0.6);
    --text-background: #ffffff;
    --text: #000000;
    --selection: #b3d7ff;
    --accent: #007aff;
    --edge: rgb(0 0 0 / 0.14);
    --font-ui:
      -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Hiragino Kaku Gothic ProN", sans-serif;
  }

  .window {
    --fs: 16px;
    --lh: calc(var(--fs) * 1.125 * 1.5);
    --max: calc(var(--fs) * var(--readable-em));
    --left: max(calc(var(--fs) * 4), calc((100% - var(--max)) / 2));
    --right: max(calc(var(--fs) * 2), calc(100% - var(--left) - var(--max)));
    --extra: clamp(0px, calc((var(--right) - var(--fs) * 2) / 2), calc(var(--fs) * 4));

    position: relative;
    overflow: hidden;
    border-radius: 16px;
    background: var(--text-background);
    color: var(--label);
    box-shadow:
      0 0 0 0.5px var(--edge),
      0 2px 6px rgb(0 0 0 / 0.06),
      0 30px 80px rgb(19 51 59 / 0.18);
    font: 13px/1.3 var(--font-ui);
    -webkit-font-smoothing: antialiased;
  }

  .doc {
    padding: calc(32px + var(--fs) + var(--extra)) var(--right) calc(32px + var(--fs) + var(--extra))
      var(--left);
    counter-reset: line;
    color: var(--text);
    font-family: "Plainsong Japanese", -apple-system, BlinkMacSystemFont, "Hiragino Sans", sans-serif;
    font-size: var(--fs);
    line-height: var(--lh);
    text-align: start;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    word-break: normal;
    line-break: auto;
    hanging-punctuation: none;
    text-wrap: wrap;
    font-kerning: normal;
    text-spacing-trim: trim-start;
    text-spacing-trim: trim-all;
    text-autospace: normal;
  }

  @media (width >= 40rem) {
    .doc {
      text-align: justify;
    }
  }

  .doc ::selection {
    background: var(--selection);
  }

  .doc > * {
    position: relative;
    min-height: 1lh;
    margin: 0 0 calc(var(--fs) * 1.125 * 0.5);
    font: inherit;
    letter-spacing: inherit;
  }

  .doc > *::before {
    counter-increment: line;
    content: counter(line);
    content: counter(line) / "";
    position: absolute;
    top: 0;
    left: calc(var(--fs) * -4);
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(var(--fs) * 4);
    height: var(--lh);
    color: var(--label-secondary);
    font: 14px / 1 var(--font-ui);
    font-variant-numeric: tabular-nums;
    translate: 0 -0.5px;
    user-select: none;
  }

  .caret {
    position: absolute;
    width: 2px;
    border-radius: 1px;
    background: var(--accent);
    pointer-events: none;
    animation: blink 1.06s steps(1, end) 5;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .titlebar {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    height: 32px;
    padding-left: 14px;
  }

  .lights {
    display: flex;
    gap: 8px;
  }

  .lights i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ff5f57;
    box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.14);
  }

  .lights i:nth-child(2) {
    background: #febc2e;
  }

  .lights i:nth-child(3) {
    background: #28c840;
  }

  .statusbar {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    align-items: center;
    height: 32px;
    padding: 0 var(--right) 0 var(--left);
    color: var(--label-secondary);
  }

  .count {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
</style>
