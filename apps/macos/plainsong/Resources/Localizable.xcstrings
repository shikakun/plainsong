    "error.unencodable.title %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The text contains characters that can’t be saved in %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このテキストには、%@で保存できない文字が含まれています"
          }
        }
      }
    },
    "error.unencodable.message %@ %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The text contains characters that can’t be saved in %1$@. Save in UTF-8 to keep all the characters. To keep %2$@, cancel and remove the characters that can’t be saved."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このテキストには、%1$@で保存できない文字が含まれています。UTF-8で保存すると、すべての文字を保存できます。%2$@のまま保存するには、キャンセルして、保存できない文字を削除してください。"
          }
        }
      }
    },
    "error.unencodable.saveAsUTF8" : {
